<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NOCREPORTGENERATOR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NOCREPORTGENERATOR">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="ShellBaseFontFamily">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="ShellDisplayFontFamily">Segoe UI Variable Display</FontFamily>

            <LinearGradientBrush x:Key="ShellBackgroundBrush" EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FFD4FFFB" Offset="0" />
                <GradientStop Color="#FFB5FDF8" Offset="0.52" />
                <GradientStop Color="#FFB2FFFC" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ShellHeroGradientBrush" EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FF00231B" Offset="0" />
                <GradientStop Color="#FF005049" Offset="0.58" />
                <GradientStop Color="#FF135773" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ShellPrimaryButtonGradientBrush" EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FF005046" Offset="0" />
                <GradientStop Color="#FF008373" Offset="0.64" />
                <GradientStop Color="#FF38A291" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ShellSubtleGradientBrush" EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#FFBAFFFD" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ShellPanelBackgroundBrush" Color="#FFFDFEFF" />
            <SolidColorBrush x:Key="ShellPanelSecondaryBackgroundBrush" Color="#FFBAFFFD" />
            <SolidColorBrush x:Key="ShellPanelTertiaryBackgroundBrush" Color="#FFADF5F0" />
            <SolidColorBrush x:Key="ShellPanelBorderBrush" Color="#FF55908B" />
            <SolidColorBrush x:Key="ShellGlassStrongBorderBrush" Color="#FF236762" />
            <SolidColorBrush x:Key="ShellNavSelectedBackgroundBrush" Color="#FF38A291" />
            <SolidColorBrush x:Key="ShellNavSelectedBorderBrush" Color="#FF005046" />
            <SolidColorBrush x:Key="ShellNavDefaultBackgroundBrush" Color="#FFDBFFFF" />
            <SolidColorBrush x:Key="ShellNavDefaultBorderBrush" Color="#FF619C97" />
            <SolidColorBrush x:Key="ShellNavForegroundBrush" Color="#FF0E1A26" />
            <SolidColorBrush x:Key="ShellMutedForegroundBrush" Color="#FF4A6170" />
            <SolidColorBrush x:Key="ShellTitleForegroundBrush" Color="#FF0E1A26" />
            <SolidColorBrush x:Key="ShellGlowBlueBrush" Color="#33005046" />
            <SolidColorBrush x:Key="ShellGlowCyanBrush" Color="#3338A291" />
            <SolidColorBrush x:Key="ShellHeroPrimaryTextBrush" Color="#FFF4FEFD" />
            <SolidColorBrush x:Key="ShellHeroSecondaryTextBrush" Color="#FFD4F3EE" />
            <SolidColorBrush x:Key="ShellHeroCaptionTextBrush" Color="#FFB8E4DD" />
            <SolidColorBrush x:Key="ShellNeonAccentBrush" Color="#FF38A291" />
            <SolidColorBrush x:Key="ShellDangerBrush" Color="#FFD54857" />
            <SolidColorBrush x:Key="ShellTitleBarBackgroundBrush" Color="#EAD4FFFB" />
            <SolidColorBrush x:Key="ShellSidebarFooterBackgroundBrush" Color="#FFBAFFFD" />
            <SolidColorBrush x:Key="ShellWorkspaceBadgeBackgroundBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ShellWorkspaceBadgeBorderBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="ShellContentBadgeBackgroundBrush" Color="#FFE0FFFC" />
            <SolidColorBrush x:Key="ShellContentBadgeBorderBrush" Color="#FF9ED7D2" />
            <SolidColorBrush x:Key="ShellImportProgressBackgroundBrush" Color="#FFF4FBF9" />

            <Style x:Key="ShellGlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ShellPanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ShellPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="ShellGlassSubtleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ShellSubtleGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ShellPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="ShellPageHeaderCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="22" />
                <Setter Property="Background" Value="{StaticResource ShellHeroGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ShellGlassStrongBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <Style x:Key="ShellNavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="13,12" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="{StaticResource ShellNavDefaultBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ShellNavDefaultBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource ShellNavForegroundBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellPrimaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Background" Value="{StaticResource ShellPrimaryButtonGradientBrush}" />
                <Setter Property="Foreground" Value="#FFF5FFFD" />
                <Setter Property="BorderBrush" Value="#FF005046" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellSecondaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Background" Value="#FFEEFFFC" />
                <Setter Property="Foreground" Value="{StaticResource ShellNavForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ShellPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellInputTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#FFFCFFFE" />
                <Setter Property="BorderBrush" Value="#FF9ED7D2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellInputPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="#FFFCFFFE" />
                <Setter Property="BorderBrush" Value="#FF9ED7D2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellInputComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#FFFCFFFE" />
                <Setter Property="BorderBrush" Value="#FF9ED7D2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellInputAutoSuggestBoxStyle" TargetType="AutoSuggestBox">
                <Setter Property="Background" Value="#FFFCFFFE" />
                <Setter Property="BorderBrush" Value="#FF9ED7D2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellInputCalendarDatePickerStyle" TargetType="CalendarDatePicker">
                <Setter Property="Background" Value="#FFFCFFFE" />
                <Setter Property="BorderBrush" Value="#FF9ED7D2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ShellDisplayFontFamily}" />
                <Setter Property="FontSize" Value="23" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource ShellTitleForegroundBrush}" />
            </Style>

            <Style x:Key="ShellSectionCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource ShellMutedForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ShellHeroTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ShellDisplayFontFamily}" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource ShellHeroPrimaryTextBrush}" />
            </Style>

            <Style x:Key="ShellBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource ShellMutedForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="Expander">
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="Page">
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ShellBaseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource ShellTitleForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
