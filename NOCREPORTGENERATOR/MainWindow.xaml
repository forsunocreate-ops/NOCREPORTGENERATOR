<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="NOCREPORTGENERATOR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:materialIcons="using:Material.Icons.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d"
    Title="NOC Report Generator">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRootGrid" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="20" />
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellContentGrid.Padding" Value="16,10,16,16" />
                        <Setter Target="ShellSidebarColumn.Width" Value="318" />
                        <Setter Target="ShellSidebarBorder.Margin" Value="0,0,14,0" />
                        <Setter Target="SidebarWorkspaceCard.Visibility" Value="Visible" />
                        <Setter Target="DashboardNavText.Visibility" Value="Visible" />
                        <Setter Target="CreateTtNavText.Visibility" Value="Visible" />
                        <Setter Target="LiveMapNavText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellContentGrid.Padding" Value="10,6,10,10" />
                        <Setter Target="ShellSidebarColumn.Width" Value="90" />
                        <Setter Target="ShellSidebarBorder.Margin" Value="0,0,10,0" />
                        <Setter Target="SidebarWorkspaceCard.Visibility" Value="Collapsed" />
                        <Setter Target="DashboardNavText.Visibility" Value="Collapsed" />
                        <Setter Target="CreateTtNavText.Visibility" Value="Collapsed" />
                        <Setter Target="LiveMapNavText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBarDragRegion"
            Grid.Row="0"
            Padding="16,6,120,8"
            Background="Transparent">
            <Border
                VerticalAlignment="Center"
                Padding="12,8"
                Background="{StaticResource ShellPanelBackgroundBrush}"
                BorderBrush="{StaticResource ShellPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="#40FFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid>
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTitleForegroundBrush}"
                                Kind="NotebookEditOutline" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ShellTitleForegroundBrush}"
                            Text="NOC Report Generator" />
                        <TextBlock
                            x:Name="WindowSubtitleTextBlock"
                            FontSize="11"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Text="Network incident template workspace" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ShellContentGrid" Grid.Row="1" Padding="16,10,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="318" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ShellSidebarBorder"
                Grid.Column="0"
                Margin="0,0,14,0"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="SidebarWorkspaceCard"
                        Grid.Row="0"
                        Padding="14"
                        Background="{StaticResource ShellHeroGradientBrush}"
                        BorderBrush="{StaticResource ShellGlassStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource ShellHeroCaptionTextBrush}"
                                    Text="Workspace" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                    Text="Incident Desk" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                                    Text="Kelola ticket, draft, dan template laporan outage." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="28"
                                        Height="28"
                                        Background="#3AFFFFFF"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                            Text="N" />
                                    </Border>
                                    <FontIcon Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Glyph="&#xEB51;" />
                                    <Border
                                        x:Name="LottiePulseHost"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Width="52"
                                Height="52"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#30FFFFFF"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="26" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="4">
                        <TextBlock
                            Margin="6,0,0,4"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Style="{StaticResource ShellSectionCaptionStyle}"
                            Text="Navigation" />

                        <Button
                            x:Name="DashboardNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource ShellNavButtonStyle}"
                            Tag="dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <fluentIcons:SymbolIcon Symbol="Home" />
                                <TextBlock x:Name="DashboardNavText" Text="Dashboard" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CreateTtNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource ShellNavButtonStyle}"
                            Tag="create-tt">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <fluentIcons:SymbolIcon Symbol="Edit" />
                                <TextBlock x:Name="CreateTtNavText" Text="Create TT" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="LiveMapNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource ShellNavButtonStyle}"
                            Tag="live-map">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <fluentIcons:SymbolIcon Symbol="Map" />
                                <TextBlock x:Name="LiveMapNavText" Text="Live Map" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="3"
                        Padding="10"
                        Background="#55FFFFFF"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <ToggleSwitch
                                x:Name="DeveloperModeToggleSwitch"
                                Header="Developer Mode"
                                Toggled="DeveloperModeToggleSwitch_Toggled" />
                            <Button
                                x:Name="ViewLogsButton"
                                Click="ViewLogsButton_Click"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource ShellSecondaryButtonStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" />
                                    <TextBlock Text="View Error Logs" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="14"
                        Background="{StaticResource ShellHeroGradientBrush}"
                        BorderBrush="{StaticResource ShellGlassStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource ShellHeroCaptionTextBrush}"
                                    Text="Current Module" />
                                <TextBlock
                                    x:Name="CurrentPageTitleTextBlock"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                    Text="Dashboard" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                                Text="WinUIEx Shell" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Frame x:Name="ContentFrame">
                            <Frame.ContentTransitions>
                                <TransitionCollection>
                                    <NavigationThemeTransition />
                                    <EntranceThemeTransition FromVerticalOffset="12" />
                                </TransitionCollection>
                            </Frame.ContentTransitions>
                        </Frame>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</winex:WindowEx>
