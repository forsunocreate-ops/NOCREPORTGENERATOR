<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="NOCREPORTGENERATOR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:materialIcons="using:Material.Icons.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.Core"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d"
    Title="NOC Report Generator">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRootGrid" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="20" />
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellContentGrid.Padding" Value="16,8,16,16" />
                        <Setter Target="ShellSidebarColumn.Width" Value="304" />
                        <Setter Target="ShellSidebarBorder.Margin" Value="0,0,14,0" />
                        <Setter Target="SidebarWorkspaceCard.Visibility" Value="Visible" />
                        <Setter Target="DashboardNavText.Visibility" Value="Visible" />
                        <Setter Target="CreateTtNavText.Visibility" Value="Visible" />
                        <Setter Target="LiveMapNavText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellContentGrid.Padding" Value="10,6,10,10" />
                        <Setter Target="ShellSidebarColumn.Width" Value="84" />
                        <Setter Target="ShellSidebarBorder.Margin" Value="0,0,10,0" />
                        <Setter Target="SidebarWorkspaceCard.Visibility" Value="Collapsed" />
                        <Setter Target="DashboardNavText.Visibility" Value="Collapsed" />
                        <Setter Target="CreateTtNavText.Visibility" Value="Collapsed" />
                        <Setter Target="LiveMapNavText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBarDragRegion"
            Grid.Row="0"
            Padding="16,0,120,0"
            Background="Transparent">
            <Border
                VerticalAlignment="Center"
                Padding="10,5"
                Background="{StaticResource ShellPanelBackgroundBrush}"
                BorderBrush="{StaticResource ShellPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Grid>
                        <materialIcons:MaterialIcon
                            Width="18"
                            Height="18"
                            Foreground="{StaticResource ShellTitleForegroundBrush}"
                            Kind="Abacus" />
                        <FontIcon
                            Margin="12,0,0,0"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Glyph="&#xE895;" />
                    </Grid>
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="NOC Report Generator" />
                        <TextBlock
                            x:Name="WindowSubtitleTextBlock"
                            FontSize="11"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Text="Network incident template workspace" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShellContentGrid" Grid.Row="1" Padding="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ShellSidebarBorder"
                Grid.Column="0"
                Margin="0,0,14,0"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="SidebarWorkspaceCard"
                        Grid.Row="0"
                        Padding="12"
                        Background="{StaticResource ShellHeroGradientBrush}"
                        BorderBrush="{StaticResource ShellGlassStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Workspace" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="Incident Desk" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                                    Text="Track, draft, and map outage reports." />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <syncfusion:SfAvatarView AvatarName="NOC Team" />
                                    <FontIcon Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Glyph="&#xEB51;" />
                                    <Border
                                        x:Name="LottiePulseHost"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="54"
                                Height="54"
                                HorizontalAlignment="Right"
                                Background="#2EFFFFFF"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="27" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <Button
                            x:Name="DashboardNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource ShellNavButtonStyle}"
                            Tag="dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <fluentIcons:SymbolIcon Symbol="Home" />
                                <TextBlock x:Name="DashboardNavText" Text="Dashboard" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CreateTtNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource ShellNavButtonStyle}"
                            Tag="create-tt">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE70F;" />
                                <TextBlock x:Name="CreateTtNavText" Text="Create TT" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="LiveMapNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource ShellNavButtonStyle}"
                            Tag="live-map">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE707;" />
                                <TextBlock x:Name="LiveMapNavText" Text="Live Map" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Spacing="8">
                        <ToggleSwitch
                            x:Name="DeveloperModeToggleSwitch"
                            Header="Developer Mode"
                            Toggled="DeveloperModeToggleSwitch_Toggled" />
                        <Button
                            x:Name="ViewLogsButton"
                            Click="ViewLogsButton_Click"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource ShellPrimaryButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" />
                                <TextBlock Text="View Error Logs" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12"
                        Background="{StaticResource ShellHeroGradientBrush}"
                        BorderBrush="{StaticResource ShellGlassStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Current Module" />
                                <TextBlock
                                    x:Name="CurrentPageTitleTextBlock"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                    Text="Dashboard" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                                Text="WinUIEx + Fluent + Material + Syncfusion" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Frame x:Name="ContentFrame">
                            <Frame.ContentTransitions>
                                <TransitionCollection>
                                    <NavigationThemeTransition />
                                    <EntranceThemeTransition FromVerticalOffset="12" />
                                </TransitionCollection>
                            </Frame.ContentTransitions>
                        </Frame>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</winex:WindowEx>
