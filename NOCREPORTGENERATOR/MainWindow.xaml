<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NOCREPORTGENERATOR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NOC Report Generator">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView x:Name="AppNavigationView" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" ItemInvoked="AppNavigationView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="Create TT" Icon="Edit" Tag="create-tt" />
                <NavigationViewItem Content="Live Map" Icon="Map" Tag="live-map" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
