<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="NOCREPORTGENERATOR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d"
    Title="NOC Report Generator">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRootGrid" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="20" />
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellContentGrid.Padding" Value="18,12,18,18" />
                        <Setter Target="ShellSidebarColumn.Width" Value="318" />
                        <Setter Target="ShellSidebarBorder.Margin" Value="0,0,16,0" />
                        <Setter Target="SidebarWorkspaceCard.Visibility" Value="Visible" />
                        <Setter Target="DashboardNavText.Visibility" Value="Visible" />
                        <Setter Target="CreateTtNavText.Visibility" Value="Visible" />
                        <Setter Target="LiveMapNavText.Visibility" Value="Visible" />
                        <Setter Target="HistoryTtNavText.Visibility" Value="Visible" />
                        <Setter Target="SettingsNavText.Visibility" Value="Visible" />
                        <Setter Target="Incident360NavText.Visibility" Value="Visible" />
                        <Setter Target="SlaMonitorNavText.Visibility" Value="Visible" />
                        <Setter Target="CommandCenterNavText.Visibility" Value="Visible" />
                        <Setter Target="RcaNavText.Visibility" Value="Visible" />
                        <Setter Target="WorkloadNavText.Visibility" Value="Visible" />
                        <Setter Target="RulesNavText.Visibility" Value="Visible" />
                        <Setter Target="IntegrationNavText.Visibility" Value="Visible" />
                        <Setter Target="DataQualityNavText.Visibility" Value="Visible" />
                        <Setter Target="NotificationNavText.Visibility" Value="Visible" />
                        <Setter Target="ReportBuilderNavText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellContentGrid.Padding" Value="10,8,10,10" />
                        <Setter Target="ShellSidebarColumn.Width" Value="96" />
                        <Setter Target="ShellSidebarBorder.Margin" Value="0,0,10,0" />
                        <Setter Target="SidebarWorkspaceCard.Visibility" Value="Collapsed" />
                        <Setter Target="DashboardNavText.Visibility" Value="Collapsed" />
                        <Setter Target="CreateTtNavText.Visibility" Value="Collapsed" />
                        <Setter Target="LiveMapNavText.Visibility" Value="Collapsed" />
                        <Setter Target="HistoryTtNavText.Visibility" Value="Collapsed" />
                        <Setter Target="SettingsNavText.Visibility" Value="Collapsed" />
                        <Setter Target="Incident360NavText.Visibility" Value="Collapsed" />
                        <Setter Target="SlaMonitorNavText.Visibility" Value="Collapsed" />
                        <Setter Target="CommandCenterNavText.Visibility" Value="Collapsed" />
                        <Setter Target="RcaNavText.Visibility" Value="Collapsed" />
                        <Setter Target="WorkloadNavText.Visibility" Value="Collapsed" />
                        <Setter Target="RulesNavText.Visibility" Value="Collapsed" />
                        <Setter Target="IntegrationNavText.Visibility" Value="Collapsed" />
                        <Setter Target="DataQualityNavText.Visibility" Value="Collapsed" />
                        <Setter Target="NotificationNavText.Visibility" Value="Collapsed" />
                        <Setter Target="ReportBuilderNavText.Visibility" Value="Collapsed" />
                        <Setter Target="WindowSubtitleTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="CurrentPageTitleTextBlock.FontSize" Value="24" />
                        <Setter Target="WorkspaceBadgeBorder.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBarDragRegion"
            Grid.Row="0"
            Padding="16,6,160,6"
            Background="{StaticResource ShellTitleBarBackgroundBrush}">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock
                    FontFamily="{StaticResource ShellDisplayFontFamily}"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ShellTitleForegroundBrush}"
                    Text="NOC Report Generator" />
                <TextBlock
                    x:Name="WindowSubtitleTextBlock"
                    Visibility="Visible"
                    FontSize="11"
                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                    Text="Network incident template workspace" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ShellContentGrid" Grid.Row="1" Padding="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="318" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ShellSidebarBorder"
                Grid.Column="0"
                Margin="0,0,14,0"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="SidebarWorkspaceCard"
                        Grid.Row="0"
                        Style="{StaticResource ShellPageHeaderCardStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource ShellHeroCaptionTextBrush}"
                                    Text="Workspace" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                    Text="Incident Desk" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                                    Text="Kelola ticket, draft, dan template laporan outage." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="28"
                                        Height="28"
                                        Background="{StaticResource ShellWorkspaceBadgeBackgroundBrush}"
                                        BorderBrush="{StaticResource ShellWorkspaceBadgeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                            Text="N" />
                                    </Border>
                                    <fluentIcons:SymbolIcon Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Symbol="Board" />
                                    <Border
                                        x:Name="LottiePulseHost"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Width="52"
                                Height="52"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource ShellWorkspaceBadgeBackgroundBrush}"
                                BorderBrush="{StaticResource ShellWorkspaceBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="26" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,16,0,10"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Margin="6,0,0,4"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Style="{StaticResource ShellSectionCaptionStyle}"
                                Text="Navigation" />

                            <Button
                                x:Name="DashboardNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="dashboard">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Home" />
                                    <TextBlock x:Name="DashboardNavText" Text="Dashboard" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="CreateTtNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="create-tt">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Edit" />
                                    <TextBlock x:Name="CreateTtNavText" Text="Create TT" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="LiveMapNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="live-map">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Map" />
                                    <TextBlock x:Name="LiveMapNavText" Text="Live Map" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="HistoryTtNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="history-tt">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="History" />
                                    <TextBlock x:Name="HistoryTtNavText" Text="History TT" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="SettingsNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="settings">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Settings" />
                                    <TextBlock x:Name="SettingsNavText" Text="Settings" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Margin="6,8,0,4"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Style="{StaticResource ShellSectionCaptionStyle}"
                                Text="Advanced Ops" />

                            <Button
                                x:Name="Incident360NavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="incident-360">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Warning" />
                                    <TextBlock x:Name="Incident360NavText" Text="Incident 360" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="SlaMonitorNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="sla-monitor">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Clock" />
                                    <TextBlock x:Name="SlaMonitorNavText" Text="SLA Monitor" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="CommandCenterNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="command-center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Grid" />
                                    <TextBlock x:Name="CommandCenterNavText" Text="Command Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RcaNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="rca-problem">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Bug" />
                                    <TextBlock x:Name="RcaNavText" Text="RCA Problem" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="WorkloadNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="workload-shift">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="People" />
                                    <TextBlock x:Name="WorkloadNavText" Text="Workload Shift" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RulesNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="automation-rules">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="TaskList" />
                                    <TextBlock x:Name="RulesNavText" Text="Automation Rules" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="IntegrationNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="integration-health">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Server" />
                                    <TextBlock x:Name="IntegrationNavText" Text="Integration Health" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="DataQualityNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="data-quality">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="DataHistogram" />
                                    <TextBlock x:Name="DataQualityNavText" Text="Data Quality" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="NotificationNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="notification-center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Alert" />
                                    <TextBlock x:Name="NotificationNavText" Text="Notification Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="ReportBuilderNavButton"
                                Click="NavButton_Click"
                                Style="{StaticResource ShellNavButtonStyle}"
                                Tag="report-builder">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fluentIcons:SymbolIcon Symbol="Document" />
                                    <TextBlock x:Name="ReportBuilderNavText" Text="Report Builder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{StaticResource ShellSidebarFooterBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <ToggleSwitch
                                x:Name="DeveloperModeToggleSwitch"
                                Header="Developer Mode"
                                Toggled="DeveloperModeToggleSwitch_Toggled" />
                            <Button
                                x:Name="ViewLogsButton"
                                Click="ViewLogsButton_Click"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource ShellSecondaryButtonStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluentIcons:SymbolIcon Symbol="DocumentSearch" />
                                    <TextBlock Text="View Error Logs" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ContentHeaderRowDefinition" Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="ContentHeaderBorder"
                        Grid.Row="0"
                        Style="{StaticResource ShellPageHeaderCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource ShellHeroCaptionTextBrush}"
                                    Text="Current Module" />
                                <TextBlock
                                    x:Name="CurrentPageTitleTextBlock"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                                    Text="Dashboard"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="HeaderImportButton"
                                    Click="HeaderImportButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="ArrowUpload" />
                                        <TextBlock Text="Import TT" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="HeaderRefreshButton"
                                    Click="HeaderRefreshButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="ArrowClockwise" />
                                        <TextBlock Text="Refresh" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    x:Name="WorkspaceBadgeBorder"
                                    Padding="10,5"
                                    Background="{StaticResource ShellContentBadgeBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellContentBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellNavForegroundBrush}"
                                        Text="NOC Workspace" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ContentHostBorder"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Frame x:Name="ContentFrame">
                            <Frame.ContentTransitions>
                                <TransitionCollection>
                                    <NavigationThemeTransition />
                                    <EntranceThemeTransition FromVerticalOffset="12" />
                                </TransitionCollection>
                            </Frame.ContentTransitions>
                        </Frame>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="ImportProgressBorder"
            Grid.Row="2"
            Margin="14,0,14,10"
            Padding="12,10"
            Background="{StaticResource ShellImportProgressBackgroundBrush}"
            BorderBrush="{StaticResource ShellPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="ImportProgressTextBlock"
                        Foreground="{StaticResource ShellTitleForegroundBrush}"
                        Text="Background job berjalan..." />
                    <ProgressBar
                        x:Name="ImportProgressBar"
                        Height="8"
                        IsIndeterminate="True"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
                </StackPanel>

                <Button
                    x:Name="CancelImportButton"
                    Grid.Column="1"
                    Click="CancelImportButton_Click"
                    Style="{StaticResource ShellSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fluentIcons:SymbolIcon Symbol="DismissCircle" />
                        <TextBlock Text="Cancel Job" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</winex:WindowEx>
