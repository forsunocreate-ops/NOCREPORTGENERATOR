<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="16" />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="DashboardRootGrid" Padding="16" RowSpacing="12">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ShellPageHeaderCardStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Advanced NOC Console" />
                        <TextBlock
                            Style="{StaticResource ShellHeroTitleTextStyle}"
                            Text="TT Performance Dashboard v2" />
                        <TextBlock
                            Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                            Text="KPI eksekutif, SLA risk analytics, workload, root cause intelligence, dan queue prioritas." />
                    </StackPanel>

                    <Border
                        x:Name="DashboardHeroVisualHost"
                        Grid.Column="1"
                        Width="66"
                        Height="66"
                        Background="#34FFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="33" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="10" RowSpacing="10" MinWidth="1280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="TT Baru Hari Ini" />
                                <TextBlock x:Name="TotalTodayTextBlock" FontSize="28" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Open Total" />
                                <TextBlock x:Name="OpenAllTextBlock" FontSize="28" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Open Critical" />
                                <TextBlock x:Name="OpenCriticalTextBlock" FontSize="28" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Open Major" />
                                <TextBlock x:Name="OpenMajorTextBlock" FontSize="28" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Open Minor/Other" />
                                <TextBlock x:Name="OpenMinorTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Closed" />
                                <TextBlock x:Name="ClosedTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Cancel" />
                                <TextBlock x:Name="CancelTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="1" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Draft Lokal" />
                                <TextBlock x:Name="DraftLocalTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="MTTA (menit)" />
                                <TextBlock x:Name="MttaTextBlock" FontSize="22" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="MTTR (menit)" />
                                <TextBlock x:Name="MttrTextBlock" FontSize="22" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="SLA Compliance" />
                                <TextBlock x:Name="SlaComplianceTextBlock" FontSize="22" FontWeight="SemiBold" Text="0%" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="2" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Repeat Incident" />
                                <TextBlock x:Name="RepeatIncidentTextBlock" FontSize="22" FontWeight="SemiBold" Text="0%" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="3" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Backlog &gt; 24 Jam" />
                                <TextBlock x:Name="Aging24hTextBlock" FontSize="20" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="3" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Backlog &gt; 72 Jam" />
                                <TextBlock x:Name="Aging72hTextBlock" FontSize="20" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="3" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Forecast Besok" />
                                <TextBlock x:Name="ForecastTextBlock" FontSize="20" FontWeight="SemiBold" Text="0 TT" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="3" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Anomali Hari Ini" />
                                <TextBlock x:Name="AnomalyTextBlock" FontSize="20" FontWeight="SemiBold" Text="Normal" />
                                <TextBlock x:Name="DataFreshnessTextBlock" Style="{StaticResource ShellSectionCaptionStyle}" Text="Data freshness: -" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource ShellGlassCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="10" MinWidth="980">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Trend Volume TT (7 Hari)" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Pergerakan volume harian + baseline untuk monitoring lonjakan." />
                            <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                <lvc:CartesianChart
                                    Height="250"
                                    LegendPosition="Top"
                                    Series="{Binding DailyTrendSeries}"
                                    XAxes="{Binding DailyTrendXAxes}"
                                    YAxes="{Binding DailyTrendYAxes}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Status Mix" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Distribusi Open / Closed / Cancel." />
                            <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                <lvc:PieChart
                                    Height="250"
                                    LegendPosition="Bottom"
                                    Series="{Binding LinkStatusSeries}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource ShellGlassCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="10" MinWidth="980">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="SLA Risk" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="On-track, at-risk, dan breached untuk ticket Open." />
                            <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                <lvc:PieChart
                                    Height="250"
                                    LegendPosition="Bottom"
                                    Series="{Binding SlaRiskSeries}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Workload PIC (Top 8)" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Jumlah TT Open per PIC untuk distribusi beban kerja." />
                            <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                <lvc:CartesianChart
                                    Height="250"
                                    LegendPosition="Hidden"
                                    Series="{Binding PicWorkloadSeries}"
                                    XAxes="{Binding PicWorkloadXAxes}"
                                    YAxes="{Binding PicWorkloadYAxes}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource ShellGlassCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="10" MinWidth="1280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Root Cause Intelligence (Top 8)" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Kontributor masalah terbesar untuk analisis Pareto." />
                            <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                <lvc:CartesianChart
                                    Height="240"
                                    LegendPosition="Hidden"
                                    Series="{Binding RootCauseSeries}"
                                    XAxes="{Binding RootCauseXAxes}"
                                    YAxes="{Binding RootCauseYAxes}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Top Impacted Segment" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Segment route paling sering terdampak." />
                            <ListView x:Name="TopSegmentListView" MinHeight="250">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Value}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Priority Queue" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Critical queue berdasarkan severity, aging, dan SLA state." />
                            <ListView x:Name="PriorityQueueListView" MinHeight="250">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Ticket}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding Segment}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding Meta}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource ShellGlassCardStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Data Quality" />
                            <TextBlock x:Name="MissingSystemKeyTextBlock" Text="Missing System Key: 0 (0%)" />
                            <TextBlock x:Name="MissingSegmentTextBlock" Text="Missing Segment Route: 0 (0%)" />
                            <TextBlock x:Name="MissingPicTextBlock" Text="Missing PIC: 0 (0%)" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Import Pipeline Monitor" />
                            <TextBlock x:Name="ImportStateTextBlock" Text="Idle" />
                            <ProgressBar x:Name="ImportProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource ShellGlassCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="10" RowSpacing="10" MinWidth="920">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Margin="2,0,0,2"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Style="{StaticResource ShellSectionCaptionStyle}"
                            Text="Search &amp; Filter" />

                        <TextBox
                            x:Name="SearchTextBox"
                            Grid.Column="0"
                            Grid.Row="1"
                            PlaceholderText="Search title, INC, segment route, system key, PIC..."
                            Style="{StaticResource ShellInputTextBoxStyle}"
                            TextChanged="SearchTextBox_TextChanged" />

                        <ComboBox
                            x:Name="StatusFilterComboBox"
                            Grid.Column="1"
                            Grid.Row="1"
                            MinWidth="180"
                            Style="{StaticResource ShellInputComboBoxStyle}"
                            SelectionChanged="StatusFilterComboBox_SelectionChanged" />

                        <ComboBox
                            x:Name="DateFilterComboBox"
                            Grid.Column="2"
                            Grid.Row="1"
                            MinWidth="170"
                            Style="{StaticResource ShellInputComboBoxStyle}"
                            SelectionChanged="DateFilterComboBox_SelectionChanged" />

                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="3"
                            Grid.Row="1"
                            Click="RefreshButton_Click"
                            Style="{StaticResource ShellSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xF064;" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="OpenInCreateTtButton"
                            Grid.Column="4"
                            Grid.Row="1"
                            Click="OpenInCreateTtButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource ShellPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEC80;" />
                                <TextBlock Text="Open in Create TT" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="7" Style="{StaticResource ShellGlassCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" MinWidth="1120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="History TT" />
                            <TextBlock
                                x:Name="HistoryCountTextBlock"
                                Style="{StaticResource ShellSectionCaptionStyle}"
                                Text="0 item" />
                            <ListView
                                x:Name="HistoryListView"
                                MinHeight="420"
                                SelectionChanged="HistoryListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            Style="{StaticResource ShellGlassSubtleCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                                                    Text="{Binding SubHeaderText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding MetaText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Detail TT" />
                                <TextBlock
                                    x:Name="SelectedBadgeTextBlock"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                                    Text="Belum dipilih" />
                            </StackPanel>

                            <Button
                                x:Name="CopyTemplateButton"
                                Click="CopyTemplateButton_Click"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ShellSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEB91;" />
                                    <TextBlock Text="Copy Template" />
                                </StackPanel>
                            </Button>

                            <TextBox
                                x:Name="SelectedTemplateTextBox"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                MinHeight="520"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
