<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="16" />
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <LinearGradientBrush x:Key="DashboardHeroSurfaceBrush" EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="#FF00231B" Offset="0" />
            <GradientStop Color="#FF005049" Offset="0.58" />
            <GradientStop Color="#FF135773" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardHeroChipBrush" EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="#24FFFFFF" Offset="0" />
            <GradientStop Color="#0FFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardSubtleCardBrush" EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="#FFFFFFFF" Offset="0" />
            <GradientStop Color="#FFBAFFFD" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="DashboardHeroChipBorderBrush" Color="#45FFFFFF" />
        <SolidColorBrush x:Key="DashboardSubtleCardBorderBrush" Color="#FF9ED7D2" />
        <SolidColorBrush x:Key="DashboardSectionLabelBrush" Color="#FF4A6078" />
        <SolidColorBrush x:Key="DashboardEmphasisBrush" Color="#FF0E1A26" />
        <SolidColorBrush x:Key="DashboardPositiveBrush" Color="#FF1C8E5A" />
        <SolidColorBrush x:Key="DashboardRiskBrush" Color="#FFD88419" />
        <SolidColorBrush x:Key="DashboardCriticalBrush" Color="#FFD64656" />

        <Style x:Key="DashboardHeroCardStyle" TargetType="Border" BasedOn="{StaticResource ShellPageHeaderCardStyle}">
            <Setter Property="Padding" Value="26" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{StaticResource DashboardHeroSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#66619C97" />
        </Style>

        <Style x:Key="DashboardHeroChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource DashboardHeroChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DashboardHeroChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <Style x:Key="DashboardSectionCardStyle" TargetType="Border" BasedOn="{StaticResource ShellGlassCardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style x:Key="DashboardSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource ShellGlassSubtleCardStyle}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource DashboardSubtleCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DashboardSubtleCardBorderBrush}" />
        </Style>

        <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellSectionTitleStyle}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="{StaticResource DashboardEmphasisBrush}" />
        </Style>

        <Style x:Key="DashboardSectionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellSectionCaptionStyle}">
            <Setter Property="Foreground" Value="{StaticResource DashboardSectionLabelBrush}" />
        </Style>

        <Style x:Key="DashboardMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DashboardSectionLabelBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DashboardMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DashboardEmphasisBrush}" />
        </Style>

        <Style x:Key="DashboardListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="180" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="DashboardRootGrid"
            Padding="22"
            HorizontalAlignment="Center"
            MaxWidth="1820"
            RowSpacing="18">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DashboardHeroCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Advanced NOC Console" />
                        <TextBlock
                            Style="{StaticResource ShellHeroTitleTextStyle}"
                            Text="Operational Intelligence Board" />
                        <TextBlock
                            Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                            Text="Realtime KPI, SLA pressure, workload distribution, root cause signals, dan critical queue dalam satu tampilan." />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource DashboardHeroChipStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Symbol="DataHistogram" />
                                        <TextBlock Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="Realtime KPI" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardHeroChipStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Symbol="Alert" />
                                        <TextBlock Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="SLA Early Warning" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardHeroChipStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Symbol="TaskList" />
                                        <TextBlock Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="Priority Queue" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid
                        Grid.Column="1"
                        Width="250"
                        Height="120"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Ellipse
                            Width="110"
                            Height="110"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="#2AFFFFFF" />
                        <Ellipse
                            Width="78"
                            Height="78"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Fill="#33FFFFFF" />
                        <Border
                            x:Name="DashboardHeroVisualHost"
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource ShellWorkspaceBadgeBackgroundBrush}"
                            BorderBrush="{StaticResource ShellWorkspaceBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="36" />
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Spacing="4">
                            <Border Style="{StaticResource DashboardHeroChipStyle}">
                                <TextBlock Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="Coverage: 24/7" />
                            </Border>
                            <Border Style="{StaticResource DashboardHeroChipStyle}">
                                <TextBlock Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="Mode: Production" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource DashboardSectionCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Executive KPI Deck" />
                        <Border
                            Padding="10,4"
                            Background="#1438A291"
                            BorderBrush="#5538A291"
                            BorderThickness="1"
                            CornerRadius="999">
                            <TextBlock Foreground="{StaticResource DashboardEmphasisBrush}" Text="Live" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource DashboardSectionCaptionStyle}"
                        Text="Ringkasan metrik utama untuk keputusan operasional cepat pada shift saat ini." />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid ColumnSpacing="12" RowSpacing="12" MinWidth="1320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="TT Baru Hari Ini" />
                                <TextBlock x:Name="TotalTodayTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="28" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Open Total" />
                                <TextBlock x:Name="OpenAllTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="28" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Open Critical" />
                                <TextBlock x:Name="OpenCriticalTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource DashboardCriticalBrush}" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Open Major" />
                                <TextBlock x:Name="OpenMajorTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource DashboardRiskBrush}" Text="0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Open Minor/Other" />
                                <TextBlock x:Name="OpenMinorTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Closed" />
                                <TextBlock x:Name="ClosedTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Cancel" />
                                <TextBlock x:Name="CancelTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="1" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Draft Lokal" />
                                <TextBlock x:Name="DraftLocalTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="24" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="MTTA (menit)" />
                                <TextBlock x:Name="MttaTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="22" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="MTTR (menit)" />
                                <TextBlock x:Name="MttrTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="22" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="SLA Compliance" />
                                <TextBlock x:Name="SlaComplianceTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DashboardPositiveBrush}" Text="0%" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="2" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Repeat Incident" />
                                <TextBlock x:Name="RepeatIncidentTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="22" FontWeight="SemiBold" Text="0%" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="3" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Backlog &gt; 24 Jam" />
                                <TextBlock x:Name="Aging24hTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="20" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="3" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Backlog &gt; 72 Jam" />
                                <TextBlock x:Name="Aging72hTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="20" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="3" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Forecast Besok" />
                                <TextBlock x:Name="ForecastTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="20" FontWeight="SemiBold" Text="0 TT" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="3" Style="{StaticResource DashboardSubtleCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Anomali Hari Ini" />
                                <TextBlock x:Name="AnomalyTextBlock" Style="{StaticResource DashboardMetricValueStyle}" FontSize="20" FontWeight="SemiBold" Text="Normal" />
                                <TextBlock x:Name="DataFreshnessTextBlock" Style="{StaticResource DashboardSectionCaptionStyle}" Text="Data freshness: -" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource DashboardSectionCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" MinWidth="980">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Trend Volume TT (7 Hari)" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="Pergerakan volume harian + baseline untuk monitoring lonjakan." />
                            <Border Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                <lvc:CartesianChart
                                    Height="250"
                                    LegendPosition="Top"
                                    Series="{Binding DailyTrendSeries}"
                                    XAxes="{Binding DailyTrendXAxes}"
                                    YAxes="{Binding DailyTrendYAxes}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Status Mix" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="Distribusi Open / Closed / Cancel." />
                            <Border Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                <lvc:PieChart
                                    Height="250"
                                    LegendPosition="Bottom"
                                    Series="{Binding LinkStatusSeries}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource DashboardSectionCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" MinWidth="980">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="SLA Risk" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="On-track, at-risk, dan breached untuk ticket Open." />
                            <Border Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                <lvc:PieChart
                                    Height="250"
                                    LegendPosition="Bottom"
                                    Series="{Binding SlaRiskSeries}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Workload PIC (Top 8)" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="Jumlah TT Open per PIC untuk distribusi beban kerja." />
                            <Border Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                <lvc:CartesianChart
                                    Height="250"
                                    LegendPosition="Hidden"
                                    Series="{Binding PicWorkloadSeries}"
                                    XAxes="{Binding PicWorkloadXAxes}"
                                    YAxes="{Binding PicWorkloadYAxes}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource DashboardSectionCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" MinWidth="1280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Root Cause Intelligence (Top 8)" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="Kontributor masalah terbesar untuk analisis Pareto." />
                            <Border Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                <lvc:CartesianChart
                                    Height="240"
                                    LegendPosition="Hidden"
                                    Series="{Binding RootCauseSeries}"
                                    XAxes="{Binding RootCauseXAxes}"
                                    YAxes="{Binding RootCauseYAxes}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Top Impacted Segment" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="Segment route paling sering terdampak." />
                            <ListView x:Name="TopSegmentListView" MinHeight="250" Style="{StaticResource DashboardListViewStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Value}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Priority Queue" />
                            <TextBlock Style="{StaticResource DashboardSectionCaptionStyle}" Text="Critical queue berdasarkan severity, aging, dan SLA state." />
                            <ListView x:Name="PriorityQueueListView" MinHeight="250" Style="{StaticResource DashboardListViewStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Ticket}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding Segment}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding Meta}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource DashboardSectionCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Data Quality" />
                            <TextBlock x:Name="MissingSystemKeyTextBlock" Text="Missing System Key: 0 (0%)" />
                            <TextBlock x:Name="MissingSegmentTextBlock" Text="Missing Segment Route: 0 (0%)" />
                            <TextBlock x:Name="MissingPicTextBlock" Text="Missing PIC: 0 (0%)" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="12" Style="{StaticResource DashboardSubtleCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Import Pipeline Monitor" />
                            <TextBlock x:Name="ImportStateTextBlock" Text="Idle" />
                            <ProgressBar x:Name="ImportProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource DashboardSectionCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" RowSpacing="12" MinWidth="920">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Margin="2,0,0,2"
                            Spacing="2">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Search &amp; Filter" />
                            <TextBlock
                                Style="{StaticResource DashboardSectionCaptionStyle}"
                                Text="Filter cepat untuk fokus ke ticket dengan prioritas tertinggi." />
                        </StackPanel>

                        <TextBox
                            x:Name="SearchTextBox"
                            Grid.Column="0"
                            Grid.Row="1"
                            PlaceholderText="Search title, INC, segment route, system key, PIC..."
                            Style="{StaticResource ShellInputTextBoxStyle}"
                            TextChanged="SearchTextBox_TextChanged" />

                        <ComboBox
                            x:Name="StatusFilterComboBox"
                            Grid.Column="1"
                            Grid.Row="1"
                            MinWidth="180"
                            Style="{StaticResource ShellInputComboBoxStyle}"
                            SelectionChanged="StatusFilterComboBox_SelectionChanged" />

                        <ComboBox
                            x:Name="DateFilterComboBox"
                            Grid.Column="2"
                            Grid.Row="1"
                            MinWidth="170"
                            Style="{StaticResource ShellInputComboBoxStyle}"
                            SelectionChanged="DateFilterComboBox_SelectionChanged" />

                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="3"
                            Grid.Row="1"
                            Click="RefreshButton_Click"
                            Style="{StaticResource ShellSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fluentIcons:SymbolIcon Symbol="ArrowClockwise" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="OpenInCreateTtButton"
                            Grid.Column="4"
                            Grid.Row="1"
                            Click="OpenInCreateTtButton_Click"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Style="{StaticResource ShellPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fluentIcons:SymbolIcon Symbol="Edit" />
                                <TextBlock Text="Open in Create TT" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border
                x:Name="DashboardHistorySectionBorder"
                Grid.Row="7"
                Visibility="Collapsed"
                Style="{StaticResource DashboardSectionCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" MinWidth="1120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="History TT" />
                            <TextBlock
                                x:Name="HistoryCountTextBlock"
                                Style="{StaticResource DashboardSectionCaptionStyle}"
                                Text="0 item" />
                            <ListView
                                x:Name="HistoryListView"
                                MinHeight="420"
                                Style="{StaticResource DashboardListViewStyle}"
                                SelectionChanged="HistoryListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12"
                                            Style="{StaticResource DashboardSubtleCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                                                    Text="{Binding SubHeaderText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding MetaText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="Detail TT" />
                                <TextBlock
                                    x:Name="SelectedBadgeTextBlock"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                                    Text="Belum dipilih" />
                            </StackPanel>

                            <Button
                                x:Name="CopyTemplateButton"
                                Click="CopyTemplateButton_Click"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ShellSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fluentIcons:SymbolIcon Symbol="Document" />
                                    <TextBlock Text="Copy Template" />
                                </StackPanel>
                            </Button>

                            <TextBox
                                x:Name="SelectedTemplateTextBox"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                MinHeight="520"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
