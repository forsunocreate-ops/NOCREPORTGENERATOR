<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="16" />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer>
        <Grid x:Name="DashboardRootGrid" Padding="16" RowSpacing="12">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="DashboardWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1200" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DashboardRootGrid.Padding" Value="16" />
                            <Setter Target="ChartCol1.Width" Value="2*" />
                            <Setter Target="ChartCol2.Width" Value="*" />
                            <Setter Target="DetailCol1.Width" Value="2*" />
                            <Setter Target="DetailCol2.Width" Value="3*" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DashboardCompactState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DashboardRootGrid.Padding" Value="10" />
                            <Setter Target="ChartCol1.Width" Value="*" />
                            <Setter Target="ChartCol2.Width" Value="0" />
                            <Setter Target="DetailCol1.Width" Value="*" />
                            <Setter Target="DetailCol2.Width" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="16"
                Background="{StaticResource ShellHeroGradientBrush}"
                BorderBrush="{StaticResource ShellGlassStrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="KPI Board" />
                        <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource ShellHeroPrimaryTextBrush}" Text="TT Performance Dashboard" />
                        <TextBlock Foreground="{StaticResource ShellHeroSecondaryTextBrush}" Text="Monitoring volume, severity, SLA response, dan detail tiket aktif." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D2;" />
                            <FontIcon Glyph="&#xE8A7;" />
                            <FontIcon Glyph="&#xE77B;" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        x:Name="DashboardHeroVisualHost"
                        Grid.Column="1"
                        Width="60"
                        Height="60"
                        Background="#2EFFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="30" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Total TT Hari Ini" />
                        <TextBlock x:Name="TotalTodayTextBlock" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="0" />
                        <ProgressBar Height="6" IsIndeterminate="True" ShowError="False" ShowPaused="False" Value="40" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Open Critical/Major" />
                        <TextBlock x:Name="OpenCriticalMajorTextBlock" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Draft Lokal" />
                        <TextBlock x:Name="DraftLocalTextBlock" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="TT 7 Hari" />
                        <TextBlock x:Name="TotalWeekTextBlock" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Open Critical" />
                        <TextBlock x:Name="OpenCriticalTextBlock" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Avg Response (Menit)" />
                        <TextBlock x:Name="AvgResponseTextBlock" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChartCol1" Width="2*" />
                    <ColumnDefinition x:Name="ChartCol2" Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="Trend TT 7 Hari Terakhir" />
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Volume TT harian berdasarkan Occur Time." />
                        <Border Padding="8" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <lvc:CartesianChart
                                Height="250"
                                LegendPosition="Top"
                                Series="{Binding DailyTrendSeries}"
                                XAxes="{Binding DailyTrendXAxes}"
                                YAxes="{Binding DailyTrendYAxes}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="Komposisi Severity" />
                        <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Proporsi ticket Open per level severity." />
                        <Border Padding="8" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <lvc:PieChart
                                Height="250"
                                LegendPosition="Right"
                                Series="{Binding SeveritySeries}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Style="{StaticResource ShellGlassCardStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        PlaceholderText="Search title, INC, segment route, system key, PIC..."
                        TextChanged="SearchTextBox_TextChanged" />
                    <ComboBox
                        x:Name="StatusFilterComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        SelectionChanged="StatusFilterComboBox_SelectionChanged" />
                    <ComboBox
                        x:Name="DateFilterComboBox"
                        Grid.Column="2"
                        MinWidth="170"
                        SelectionChanged="DateFilterComboBox_SelectionChanged" />
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="3"
                        Click="RefreshButton_Click"
                        Style="{StaticResource ShellPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="OpenInCreateTtButton"
                        Grid.Column="4"
                        Click="OpenInCreateTtButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource ShellPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" />
                            <TextBlock Text="Open in Create TT" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DetailCol1" Width="2*" />
                    <ColumnDefinition x:Name="DetailCol2" Width="3*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="History TT" />
                        <TextBlock
                            x:Name="HistoryCountTextBlock"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Text="0 item" />
                        <ListView
                            x:Name="HistoryListView"
                            MinHeight="420"
                            SelectionChanged="HistoryListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        Style="{StaticResource ShellGlassSubtleCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding SubHeaderText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="{Binding MetaText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ShellTitleForegroundBrush}" Text="Detail TT" />
                            <TextBlock
                                x:Name="SelectedBadgeTextBlock"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Belum dipilih" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CopyTemplateButton"
                                Click="CopyTemplateButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource ShellPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" />
                                    <TextBlock Text="Copy Template" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox
                            x:Name="SelectedTemplateTextBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            MinHeight="520"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

