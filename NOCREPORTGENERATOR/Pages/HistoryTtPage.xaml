<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.HistoryTtPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="HistoryLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource ShellNavForegroundBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="HistoryRootGrid" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{StaticResource ShellHeroGradientBrush}"
            BorderBrush="{StaticResource ShellGlassStrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Data Lokal" />
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ShellHeroPrimaryTextBrush}"
                        Text="History TT" />
                    <TextBlock
                        Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                        Text="List TT tersimpan dari form Create TT." />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="ImportButton"
                        Click="ImportButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xF24A;" />
                            <TextBlock Text="Import TT" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xF064;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="SummaryTextBlock"
                    Grid.Row="0"
                    Style="{StaticResource ShellSectionCaptionStyle}"
                    Text="0 data" />

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        PlaceholderText="Filter: TT IOH, Status Link, Segment, Root Cause, CP Location..."
                        TextChanged="SearchTextBox_TextChanged" />

                    <ComboBox
                        x:Name="SortComboBox"
                        Grid.Column="1"
                        MinWidth="210"
                        SelectionChanged="SortComboBox_SelectionChanged" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="List/Page" />
                        <ComboBox
                            x:Name="PageSizeComboBox"
                            MinWidth="90"
                        SelectionChanged="PageSizeComboBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Status" />
                    <ComboBox
                        x:Name="StatusFilterComboBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        SelectionChanged="StatusFilterComboBox_SelectionChanged" />

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Segment" />
                    <ComboBox
                        x:Name="SegmentFilterComboBox"
                        Grid.Column="3"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        VerticalAlignment="Center"
                        SelectionChanged="SegmentFilterComboBox_SelectionChanged" />

                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Dispatch From" />
                    <CalendarDatePicker
                        x:Name="DispatchFromDatePicker"
                        Grid.Column="5"
                        MinWidth="220"
                        PlaceholderText="Pilih tanggal"
                        VerticalAlignment="Center"
                        DateChanged="DispatchFromDatePicker_DateChanged" />

                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Dispatch To" />
                    <CalendarDatePicker
                        x:Name="DispatchToDatePicker"
                        Grid.Column="7"
                        MinWidth="220"
                        PlaceholderText="Pilih tanggal"
                        VerticalAlignment="Center"
                        DateChanged="DispatchToDatePicker_DateChanged" />

                    <Button
                        x:Name="ResetAdvancedFilterButton"
                        Grid.Column="8"
                        Click="ResetAdvancedFilterButton_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <TextBlock Text="Reset Filter Lanjutan" />
                    </Button>
                </Grid>

                <controls:DataGrid
                    x:Name="HistoryDataGrid"
                    Grid.Row="3"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind HistoryItems, Mode=OneWay}"
                    Height="Auto"
                    RowHeight="44">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Header="TT IOH" MinWidth="240" Width="2*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="TtIohButton_Click"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        Style="{StaticResource HistoryLinkButtonStyle}">
                                        <TextBlock Text="{Binding TtIoh}" TextWrapping="NoWrap" />
                                    </Button>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn
                            Binding="{Binding StatusLink}"
                            Header="Status Link"
                            MinWidth="130"
                            Width="1.1*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding SegmentRoute}"
                            Header="Segment Route"
                            MinWidth="220"
                            Width="2*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding RootCause}"
                            Header="Root Cause"
                            MinWidth="180"
                            Width="2*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding CpLocation}"
                            Header="CP Location"
                            MinWidth="180"
                            Width="2*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding DispatchTime}"
                            Header="Dispatch Time"
                            MinWidth="170"
                            Width="1.4*" />
                        <controls:DataGridTemplateColumn Header="Delete" MinWidth="90" Width="Auto">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="DeleteRowButton_Click"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource ShellSecondaryButtonStyle}">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEC2A;" />
                                    </Button>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <Grid Grid.Row="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PrevPageButton"
                        Grid.Column="0"
                        Click="PrevPageButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEA64;" />
                            <TextBlock Text="Prev" />
                        </StackPanel>
                    </Button>

                    <StackPanel
                        x:Name="PageButtonsPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6" />

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="PageInfoTextBlock"
                            VerticalAlignment="Center"
                            Text="Page 1 / 1" />
                        <Button
                            x:Name="NextPageButton"
                            Click="NextPageButton_Click"
                            Style="{StaticResource ShellSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Next" />
                                <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEA6E;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
