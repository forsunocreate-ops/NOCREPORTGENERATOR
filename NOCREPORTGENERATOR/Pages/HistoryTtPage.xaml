<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.HistoryTtPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="HistoryHeroBackgroundBrush" Color="#F5FAFF" />
        <SolidColorBrush x:Key="HistoryCardBackgroundBrush" Color="#FCFFFFFF" />
        <SolidColorBrush x:Key="HistorySoftBorderBrush" Color="#1F2B4D73" />

        <Style x:Key="HistoryLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource ShellNavForegroundBrush}" />
        </Style>
        <Style x:Key="HistoryKpiCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource HistoryCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HistorySoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid x:Name="HistoryRootGrid" Padding="16">
        <Border
            Grid.Row="0"
            Background="{StaticResource HistoryCardBackgroundBrush}"
            BorderBrush="{StaticResource HistorySoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HistoryKpiCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Total Data" />
                            <TextBlock x:Name="KpiTotalTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource HistoryKpiCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Data Tampil" />
                            <TextBlock x:Name="KpiFilteredTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource HistoryKpiCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Status Open/Down" />
                            <TextBlock x:Name="KpiOpenTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource HistoryKpiCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellMutedForegroundBrush}" Text="Unique Segment" />
                            <TextBlock x:Name="KpiSegmentTextBlock" FontSize="24" FontWeight="SemiBold" Text="0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    x:Name="SummaryTextBlock"
                    Grid.Row="1"
                    Style="{StaticResource ShellSectionCaptionStyle}"
                    Text="0 data" />

                <Border
                    Grid.Row="2"
                    Padding="10"
                    Background="{StaticResource HistoryCardBackgroundBrush}"
                    BorderBrush="{StaticResource HistorySoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        PlaceholderText="Filter: TT IOH, Status Link, Segment, Root Cause, CP Location..."
                        Style="{StaticResource ShellInputTextBoxStyle}"
                        TextChanged="SearchTextBox_TextChanged" />

                    <ComboBox
                        x:Name="SortComboBox"
                        Grid.Column="1"
                        MinWidth="210"
                        Style="{StaticResource ShellInputComboBoxStyle}"
                        SelectionChanged="SortComboBox_SelectionChanged" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="List/Page" />
                        <ComboBox
                            x:Name="PageSizeComboBox"
                            MinWidth="90"
                            Style="{StaticResource ShellInputComboBoxStyle}"
                        SelectionChanged="PageSizeComboBox_SelectionChanged" />
                    </StackPanel>

                    <Button
                        Grid.Column="3"
                        Click="ClearSearchButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEB99;" />
                            <TextBlock Text="Clear Search" />
                        </StackPanel>
                    </Button>
                </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Padding="10"
                    Background="{StaticResource HistoryCardBackgroundBrush}"
                    BorderBrush="{StaticResource HistorySoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Status" />
                    <ComboBox
                        x:Name="StatusFilterComboBox"
                        Grid.Column="1"
                        Style="{StaticResource ShellInputComboBoxStyle}"
                        VerticalAlignment="Center"
                        SelectionChanged="StatusFilterComboBox_SelectionChanged" />

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Segment" />
                    <ComboBox
                        x:Name="SegmentFilterComboBox"
                        Grid.Column="3"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        Style="{StaticResource ShellInputComboBoxStyle}"
                        VerticalAlignment="Center"
                        SelectionChanged="SegmentFilterComboBox_SelectionChanged" />

                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Dispatch From" />
                    <CalendarDatePicker
                        x:Name="DispatchFromDatePicker"
                        Grid.Column="5"
                        MinWidth="220"
                        PlaceholderText="Pilih tanggal"
                        Style="{StaticResource ShellInputCalendarDatePickerStyle}"
                        VerticalAlignment="Center"
                        DateChanged="DispatchFromDatePicker_DateChanged" />

                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Dispatch To" />
                    <CalendarDatePicker
                        x:Name="DispatchToDatePicker"
                        Grid.Column="7"
                        MinWidth="220"
                        PlaceholderText="Pilih tanggal"
                        Style="{StaticResource ShellInputCalendarDatePickerStyle}"
                        VerticalAlignment="Center"
                        DateChanged="DispatchToDatePicker_DateChanged" />

                    <Button
                        x:Name="ResetAdvancedFilterButton"
                        Grid.Column="8"
                        Click="ResetAdvancedFilterButton_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <TextBlock Text="Reset Filter Lanjutan" />
                    </Button>
                </Grid>
                </Border>

                <controls:DataGrid
                    x:Name="HistoryDataGrid"
                    Grid.Row="4"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind HistoryItems, Mode=OneWay}"
                    Height="Auto"
                    RowHeight="44">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Header="TT IOH" MinWidth="240" Width="2*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="TtIohButton_Click"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        Style="{StaticResource HistoryLinkButtonStyle}">
                                        <TextBlock Text="{Binding TtIoh}" TextWrapping="NoWrap" />
                                    </Button>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn
                            Binding="{Binding StatusLink}"
                            Header="Status Link"
                            MinWidth="130"
                            Width="1.1*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding SegmentRoute}"
                            Header="Segment Route"
                            MinWidth="220"
                            Width="2*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding RootCause}"
                            Header="Root Cause"
                            MinWidth="180"
                            Width="2*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding CpLocation}"
                            Header="CP Location"
                            MinWidth="180"
                            Width="2*" />
                        <controls:DataGridTextColumn
                            Binding="{Binding DispatchTime}"
                            Header="Dispatch Time"
                            MinWidth="170"
                            Width="1.4*" />
                        <controls:DataGridTemplateColumn Header="Delete" MinWidth="90" Width="Auto">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="DeleteRowButton_Click"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource ShellSecondaryButtonStyle}">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEC2A;" />
                                    </Button>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <Grid Grid.Row="5" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PrevPageButton"
                        Grid.Column="0"
                        Click="PrevPageButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEA64;" />
                            <TextBlock Text="Prev" />
                        </StackPanel>
                    </Button>

                    <StackPanel
                        x:Name="PageButtonsPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6" />

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="PageInfoTextBlock"
                            VerticalAlignment="Center"
                            Text="Page 1 / 1" />
                        <Button
                            x:Name="NextPageButton"
                            Click="NextPageButton_Click"
                            Style="{StaticResource ShellSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Next" />
                                <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEA6E;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
