<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.CreateTtPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="NewTabAccelerator_Invoked" Key="T" Modifiers="Control" />
        <KeyboardAccelerator Invoked="CloseTabAccelerator_Invoked" Key="W" Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="20" />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer>
        <Grid x:Name="CreateTtLayoutRoot" Padding="16" RowSpacing="12" ColumnSpacing="12">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayoutState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1320" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CreateTtLayoutRoot.Padding" Value="16" />
                            <Setter Target="FormColumn.Width" Value="2*" />
                            <Setter Target="PreviewColumn.Width" Value="3*" />
                            <Setter Target="FormSectionBorder.(Grid.Row)" Value="0" />
                            <Setter Target="FormSectionBorder.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewSectionBorder.(Grid.Row)" Value="0" />
                            <Setter Target="PreviewSectionBorder.(Grid.Column)" Value="1" />
                            <Setter Target="PreviewTextBoxHost.MinHeight" Value="720" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompactLayoutState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CreateTtLayoutRoot.Padding" Value="10" />
                            <Setter Target="FormColumn.Width" Value="*" />
                            <Setter Target="PreviewColumn.Width" Value="0" />
                            <Setter Target="FormSectionBorder.(Grid.Row)" Value="0" />
                            <Setter Target="FormSectionBorder.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewSectionBorder.(Grid.Row)" Value="1" />
                            <Setter Target="PreviewSectionBorder.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewTextBoxHost.MinHeight" Value="360" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FormColumn" Width="2*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="FormSectionBorder"
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource ShellGlassCardStyle}">
                <StackPanel Spacing="12">
                    <TabView
                        x:Name="FormTabsTabView"
                        AddTabButtonClick="FormTabsTabView_AddTabButtonClick"
                        IsAddTabButtonVisible="True"
                        MinWidth="420"
                        SelectionChanged="FormTabsTabView_SelectionChanged"
                        TabCloseRequested="FormTabsTabView_TabCloseRequested" />

                    <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Tab Actions" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="DuplicateTabButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xECD5;" />
                                        <TextBlock Text="Duplicate Tab" />
                                    </StackPanel>
                                </Button>
                                <Button Click="LoadMsgButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEEFA;" />
                                        <TextBlock Text="Load .msg" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="MsgStatusTextBlock"
                                Margin="2,0,0,0"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Pilih email .msg untuk auto-fill form." />
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Draft Management" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="SaveNameTextBox"
                                    Grid.Column="0"
                                    PlaceholderText="Nama draft"
                                    Style="{StaticResource ShellInputTextBoxStyle}" />
                                <Button Grid.Column="1" Click="SaveLocalButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xF0B3;" />
                                        <TextBlock Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="SaveAsLocalButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xF0B1;" />
                                        <TextBlock Text="Save As" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SavedFormsComboBox"
                                    Grid.Column="0"
                                    DisplayMemberPath="DisplayName"
                                    PlaceholderText="Pilih draft tersimpan"
                                    Style="{StaticResource ShellInputComboBoxStyle}" />
                                <Button Grid.Column="1" Click="LoadSavedButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xED70;" />
                                        <TextBlock Text="Load" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="DeleteSavedButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEC2A;" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="SavedFormsSearchTextBox"
                                    Grid.Column="0"
                                    PlaceholderText="Cari draft: nama, judul, TT, segment, PIC, root cause..."
                                    Style="{StaticResource ShellInputTextBoxStyle}"
                                    TextChanged="SavedFormsSearchTextBox_TextChanged" />
                                <ComboBox
                                    x:Name="SavedFormsDateFilterComboBox"
                                    Grid.Column="1"
                                    Style="{StaticResource ShellInputComboBoxStyle}"
                                    SelectionChanged="SavedFormsFilterComboBox_SelectionChanged" />
                                <ComboBox
                                    x:Name="SavedFormsSortComboBox"
                                    Grid.Column="2"
                                    Style="{StaticResource ShellInputComboBoxStyle}"
                                    SelectionChanged="SavedFormsFilterComboBox_SelectionChanged" />
                                <Button
                                    Grid.Column="3"
                                    Click="ResetSavedFormsFilterButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEB99;" />
                                        <TextBlock Text="Reset" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock
                                x:Name="SavedFormsFilterSummaryTextBlock"
                                Style="{StaticResource ShellSectionCaptionStyle}"
                                Text="Draft tampil: 0/0" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="EmailDropZoneBorder"
                        AllowDrop="True"
                        Padding="12"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        DragOver="EmailDropZoneBorder_DragOver"
                        Drop="EmailDropZoneBorder_Drop">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Foreground="{StaticResource ShellMutedForegroundBrush}" Glyph="&#xEE4D;" />
                            <TextBlock
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Drop file email .msg di sini untuk auto-fill." />
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Incident Details" />

                            <TextBox
                                x:Name="TitleTextBox"
                                Header="Tittle"
                                PlaceholderText="Masukkan judul TT"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged" />

                            <TextBox
                                x:Name="TtIohTextBox"
                                Header="TT IOH"
                                PlaceholderText="INC-xxxxxxxx-xxxxxxxx"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged" />

                            <ComboBox
                                x:Name="StatusLinkComboBox"
                                Header="Status Link"
                                PlaceholderText="Pilih status link"
                                SelectionChanged="StatusLinkComboBox_SelectionChanged"
                                Style="{StaticResource ShellInputComboBoxStyle}" />

                            <Grid x:Name="OccurTimePanel" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Occur Time :" />
                                <TextBox
                                    x:Name="OccurTimeTextBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    LostFocus="DateTimeTextBox_LostFocus"
                                    PlaceholderText="dd-MM-yyyy HH:mm"
                                    Style="{StaticResource ShellInputTextBoxStyle}"
                                    TextAlignment="Center"
                                    TextChanged="InputChanged"
                                    Width="190" />
                            </Grid>

                            <Grid x:Name="DispatchTimePanel" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Dispatch Time :" />
                                <TextBox
                                    x:Name="DispatchTimeTextBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    LostFocus="DateTimeTextBox_LostFocus"
                                    PlaceholderText="dd-MM-yyyy HH:mm"
                                    Style="{StaticResource ShellInputTextBoxStyle}"
                                    TextAlignment="Center"
                                    TextChanged="InputChanged"
                                    Width="190" />
                            </Grid>

                            <AutoSuggestBox
                                x:Name="PicAutoSuggestBox"
                                Header="PIC"
                                PlaceholderText="Search / pilih PIC"
                                Style="{StaticResource ShellInputAutoSuggestBoxStyle}"
                                GotFocus="PicAutoSuggestBox_GotFocus"
                                QueryIcon="Find"
                                QuerySubmitted="PicAutoSuggestBox_QuerySubmitted"
                                SuggestionChosen="PicAutoSuggestBox_SuggestionChosen"
                                TextChanged="PicAutoSuggestBox_TextChanged" />

                            <TextBox
                                x:Name="RootCauseTextBox"
                                Header="Rootcause"
                                PlaceholderText="Contoh: Still Investigation"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged" />

                            <TextBox
                                x:Name="CutPointTextBox"
                                Header="Cut Point"
                                PlaceholderText="Isi cut point"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged" />

                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource ShellSectionCaptionStyle}" Text="Impact List" />
                                    <Button Grid.Column="1" Click="AddImpactListButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEA13;" />
                                            <TextBlock Text="+" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="ImpactListItemsHost" Spacing="6" />
                                <TextBlock
                                    x:Name="ImpactListEmptyHintTextBlock"
                                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                                    Text="Belum ada impact list. Klik + untuk menambah." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Network Context" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <ToggleSwitch
                                    x:Name="ShowSegmentRouteToggleSwitch"
                                    Header="Tampilkan Segment Route di Preview"
                                    IsOn="True"
                                    Toggled="PreviewOptionChanged" />
                                <ToggleSwitch
                                    x:Name="ShowSystemKeyToggleSwitch"
                                    Header="Tampilkan System Key di Preview"
                                    IsOn="True"
                                    Toggled="PreviewOptionChanged" />
                            </StackPanel>

                            <AutoSuggestBox
                                x:Name="SegmentRouteAutoSuggestBox"
                                Header="Segment Route"
                                PlaceholderText="Search / pilih Segment Route"
                                Style="{StaticResource ShellInputAutoSuggestBoxStyle}"
                                GotFocus="SegmentRouteAutoSuggestBox_GotFocus"
                                QueryIcon="Find"
                                QuerySubmitted="SegmentRouteAutoSuggestBox_QuerySubmitted"
                                SuggestionChosen="SegmentRouteAutoSuggestBox_SuggestionChosen"
                                TextChanged="SegmentRouteAutoSuggestBox_TextChanged" />

                            <TextBox
                                x:Name="SystemKeyTextBox"
                                Header="System Key"
                                PlaceholderText="Contoh: 25MAJAYNW123456"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged" />

                            <TextBox
                                x:Name="CoordinateTextBox"
                                Header="Coordinate (DMS)"
                                PlaceholderText="Contoh: 5°33'02.2&quot;N 95°21'52.8&quot;E"
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged" />

                            <Border
                                x:Name="CoordinatePhotoDropZoneBorder"
                                AllowDrop="True"
                                Padding="10"
                                Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                                BorderBrush="{StaticResource ShellPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                DragOver="CoordinatePhotoDropZoneBorder_DragOver"
                                Drop="CoordinatePhotoDropZoneBorder_Drop">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="AI Coordinate From Photo" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellMutedForegroundBrush}"
                                        Text="Drop foto watermark koordinat (local/WhatsApp), atau paste dari clipboard." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="LoadCoordinatePhotoButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                            <TextBlock Text="Load Photo" />
                                        </Button>
                                        <Button Click="PasteCoordinatePhotoButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                            <TextBlock Text="Paste WhatsApp Image" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="CoordinatePhotoStatusTextBlock"
                                        Foreground="{StaticResource ShellMutedForegroundBrush}"
                                        Text="Belum ada foto diproses." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource ShellSectionTitleStyle}"
                                Text="Update Progress" />
                            <Button
                                x:Name="TranslateUpdateProgressButton"
                                Grid.Column="1"
                                Click="TranslateUpdateProgressButton_Click"
                                Style="{StaticResource ShellSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xF0E7;" />
                                    <TextBlock Text="Translate to English" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBox
                            x:Name="UpdateProgressTextBox"
                            AcceptsReturn="True"
                            MinHeight="180"
                            PlaceholderText="Masukkan update progress per baris..."
                            Style="{StaticResource ShellInputTextBoxStyle}"
                            TextChanged="InputChanged"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="UpdateProgressTranslateStatusTextBlock"
                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                            Style="{StaticResource ShellSectionCaptionStyle}"
                            Text="Terjemahan menggunakan Gemini AI (konsisten per tab)." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="PreviewSectionBorder"
                Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource ShellGlassCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Output" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xED0F;" />
                        <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Template Preview" />
                    </StackPanel>
                    <Border
                        x:Name="PreviewTextBoxHost"
                        Padding="12"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <TextBox
                            x:Name="TemplatePreviewTextBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            MinHeight="720"
                            Style="{StaticResource ShellInputTextBoxStyle}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
