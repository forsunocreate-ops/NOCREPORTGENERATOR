<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.CreateTtPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="NewTabAccelerator_Invoked" Key="T" Modifiers="Control" />
        <KeyboardAccelerator Invoked="CloseTabAccelerator_Invoked" Key="W" Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="20" />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="CreateTtLayoutRoot" Padding="20" RowSpacing="16" ColumnSpacing="16">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayoutState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1320" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CreateTtLayoutRoot.Padding" Value="20" />
                            <Setter Target="FormColumn.Width" Value="2*" />
                            <Setter Target="PreviewColumn.Width" Value="3*" />
                            <Setter Target="FormSectionBorder.(Grid.Row)" Value="1" />
                            <Setter Target="FormSectionBorder.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewSectionBorder.(Grid.Row)" Value="1" />
                            <Setter Target="PreviewSectionBorder.(Grid.Column)" Value="1" />
                            <Setter Target="PreviewTextBoxHost.MinHeight" Value="760" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompactLayoutState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CreateTtLayoutRoot.Padding" Value="12" />
                            <Setter Target="FormColumn.Width" Value="*" />
                            <Setter Target="PreviewColumn.Width" Value="0" />
                            <Setter Target="FormSectionBorder.(Grid.Row)" Value="1" />
                            <Setter Target="FormSectionBorder.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewSectionBorder.(Grid.Row)" Value="2" />
                            <Setter Target="PreviewSectionBorder.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewTextBoxHost.MinHeight" Value="420" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FormColumn" Width="2*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ShellPageHeaderCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Ticket Composer" />
                        <TextBlock
                            Style="{StaticResource ShellHeroTitleTextStyle}"
                            Text="Create TT Workspace" />
                        <TextBlock
                            Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                            Text="Kelola draft per tab, susun detail incident lebih cepat, dan pantau template preview real-time." />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="12,7"
                        Background="{StaticResource ShellWorkspaceBadgeBackgroundBrush}"
                        BorderBrush="{StaticResource ShellWorkspaceBadgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fluentIcons:SymbolIcon Symbol="Document" />
                            <TextBlock Text="Live Preview" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                x:Name="FormSectionBorder"
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource ShellGlassCardStyle}">
                <StackPanel Spacing="12">
                    <TabView
                        x:Name="FormTabsTabView"
                        AddTabButtonClick="FormTabsTabView_AddTabButtonClick"
                        IsAddTabButtonVisible="True"
                        MinWidth="0"
                        SelectionChanged="FormTabsTabView_SelectionChanged"
                        TabCloseRequested="FormTabsTabView_TabCloseRequested" />

                    <Border Padding="12" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Workspace Actions" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="DuplicateTabButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="Document" />
                                        <TextBlock Text="Duplicate Tab" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="LoadMsgButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="DocumentSearch" />
                                        <TextBlock Text="Load .msg" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    x:Name="MsgStatusTextBlock"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    Foreground="{StaticResource ShellMutedForegroundBrush}"
                                    Text="Pilih email .msg untuk auto-fill form." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander Header="Draft Center" IsExpanded="True">
                        <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="SaveNameTextBox"
                                    Grid.Column="0"
                                    PlaceholderText="Nama draft"
                                    Style="{StaticResource ShellInputTextBoxStyle}" />
                                <Button Grid.Column="1" Click="SaveLocalButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="ArrowUpload" />
                                        <TextBlock Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="SaveAsLocalButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="ArrowUpload" />
                                        <TextBlock Text="Save As" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SavedFormsComboBox"
                                    Grid.Column="0"
                                    DisplayMemberPath="DisplayName"
                                    PlaceholderText="Pilih draft tersimpan"
                                    Style="{StaticResource ShellInputComboBoxStyle}" />
                                <Button Grid.Column="1" Click="LoadSavedButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="DocumentSearch" />
                                        <TextBlock Text="Load" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="DeleteSavedButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="DismissCircle" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Grid ColumnSpacing="8" MinWidth="760">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="SavedFormsSearchTextBox"
                                            Grid.Column="0"
                                            PlaceholderText="Cari draft: nama, judul, TT, segment, PIC, root cause..."
                                            Style="{StaticResource ShellInputTextBoxStyle}"
                                            TextChanged="SavedFormsSearchTextBox_TextChanged" />
                                        <ComboBox
                                            x:Name="SavedFormsDateFilterComboBox"
                                            Grid.Column="1"
                                            Style="{StaticResource ShellInputComboBoxStyle}"
                                            SelectionChanged="SavedFormsFilterComboBox_SelectionChanged" />
                                        <ComboBox
                                            x:Name="SavedFormsSortComboBox"
                                            Grid.Column="2"
                                            Style="{StaticResource ShellInputComboBoxStyle}"
                                            SelectionChanged="SavedFormsFilterComboBox_SelectionChanged" />
                                        <Button
                                            Grid.Column="3"
                                            Click="ResetSavedFormsFilterButton_Click"
                                            Style="{StaticResource ShellSecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fluentIcons:SymbolIcon Symbol="DismissCircle" />
                                                <TextBlock Text="Reset" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </ScrollViewer>

                                <TextBlock
                                    x:Name="SavedFormsFilterSummaryTextBlock"
                                    Style="{StaticResource ShellSectionCaptionStyle}"
                                    Text="Draft tampil: 0/0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Border
                        x:Name="EmailDropZoneBorder"
                        AllowDrop="True"
                        Padding="12"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        DragOver="EmailDropZoneBorder_DragOver"
                        Drop="EmailDropZoneBorder_Drop">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluentIcons:SymbolIcon Foreground="{StaticResource ShellMutedForegroundBrush}" Symbol="DocumentSearch" />
                            <TextBlock
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Drop file email .msg di sini untuk auto-fill." />
                        </StackPanel>
                    </Border>

                    <Expander Header="Incident Details" IsExpanded="True">
                        <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="TitleTextBox"
                                        Grid.Column="0"
                                        Header="Title"
                                        PlaceholderText="Masukkan judul TT"
                                        Style="{StaticResource ShellInputTextBoxStyle}"
                                        TextChanged="InputChanged" />
                                    <TextBox
                                        x:Name="TtIohTextBox"
                                        Grid.Column="1"
                                        Header="TT IOH"
                                        PlaceholderText="INC-xxxxxxxx-xxxxxxxx"
                                        Style="{StaticResource ShellInputTextBoxStyle}"
                                        TextChanged="InputChanged" />
                                </Grid>

                                <ComboBox
                                    x:Name="StatusLinkComboBox"
                                    Header="Status Link"
                                    PlaceholderText="Pilih status link"
                                    SelectionChanged="StatusLinkComboBox_SelectionChanged"
                                    Style="{StaticResource ShellInputComboBoxStyle}" />

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="OccurTimePanel" Grid.Row="0" Grid.Column="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Occur Time :" />
                                        <TextBox
                                            x:Name="OccurTimeTextBox"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            LostFocus="DateTimeTextBox_LostFocus"
                                            PlaceholderText="dd-MM-yyyy HH:mm"
                                            Style="{StaticResource ShellInputTextBoxStyle}"
                                            TextAlignment="Center"
                                            TextChanged="InputChanged" />
                                    </Grid>

                                    <Grid x:Name="DispatchTimePanel" Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Dispatch Time :" />
                                        <TextBox
                                            x:Name="DispatchTimeTextBox"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            LostFocus="DateTimeTextBox_LostFocus"
                                            PlaceholderText="dd-MM-yyyy HH:mm"
                                            Style="{StaticResource ShellInputTextBoxStyle}"
                                            TextAlignment="Center"
                                            TextChanged="InputChanged" />
                                    </Grid>

                                    <Grid x:Name="FinishTimePanel" Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Finish Time :" />
                                        <TextBox
                                            x:Name="FinishTimeTextBox"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            LostFocus="DateTimeTextBox_LostFocus"
                                            PlaceholderText="dd-MM-yyyy HH:mm"
                                            Style="{StaticResource ShellInputTextBoxStyle}"
                                            TextAlignment="Center"
                                            TextChanged="InputChanged" />
                                    </Grid>

                                    <Grid x:Name="MttrPanel" Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="MTTR :" />
                                        <TextBox
                                            x:Name="MttrTextBox"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            IsReadOnly="True"
                                            PlaceholderText="-"
                                            Style="{StaticResource ShellInputTextBoxStyle}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <AutoSuggestBox
                                        x:Name="PicAutoSuggestBox"
                                        Grid.Column="0"
                                        Header="PIC"
                                        PlaceholderText="Search / pilih PIC"
                                        Style="{StaticResource ShellInputAutoSuggestBoxStyle}"
                                        GotFocus="PicAutoSuggestBox_GotFocus"
                                        QueryIcon="Find"
                                        QuerySubmitted="PicAutoSuggestBox_QuerySubmitted"
                                        SuggestionChosen="PicAutoSuggestBox_SuggestionChosen"
                                        TextChanged="PicAutoSuggestBox_TextChanged" />
                                    <TextBox
                                        x:Name="RootCauseTextBox"
                                        Grid.Column="1"
                                        Header="Root Cause"
                                        PlaceholderText="Contoh: Still Investigation"
                                        Style="{StaticResource ShellInputTextBoxStyle}"
                                        TextChanged="InputChanged" />
                                </Grid>

                                <TextBox
                                    x:Name="CutPointTextBox"
                                    Header="Cut Point"
                                    PlaceholderText="Isi cut point"
                                    Style="{StaticResource ShellInputTextBoxStyle}"
                                    TextChanged="InputChanged" />

                                <Border Padding="12" Style="{StaticResource ShellGlassSubtleCardStyle}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource ShellSectionCaptionStyle}" Text="Impact List" />
                                            <Button Grid.Column="1" Click="AddImpactListButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <fluentIcons:SymbolIcon Symbol="Edit" />
                                                    <TextBlock Text="Tambah" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <StackPanel x:Name="ImpactListItemsHost" Spacing="6" />
                                        <TextBlock
                                            x:Name="ImpactListEmptyHintTextBlock"
                                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                                            Text="Belum ada impact list. Klik Tambah untuk menambah." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="Network Context" IsExpanded="True">
                        <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource ShellGlassSubtleCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch
                                        x:Name="ShowSegmentRouteToggleSwitch"
                                        Grid.Column="0"
                                        Header="Tampilkan Segment Route di Preview"
                                        IsOn="True"
                                        Toggled="PreviewOptionChanged" />
                                    <ToggleSwitch
                                        x:Name="ShowSystemKeyToggleSwitch"
                                        Grid.Column="1"
                                        Header="Tampilkan System Key di Preview"
                                        IsOn="True"
                                        Toggled="PreviewOptionChanged" />
                                </Grid>

                                <AutoSuggestBox
                                    x:Name="SegmentRouteAutoSuggestBox"
                                    Header="Segment Route"
                                    PlaceholderText="Search / pilih Segment Route"
                                    Style="{StaticResource ShellInputAutoSuggestBoxStyle}"
                                    GotFocus="SegmentRouteAutoSuggestBox_GotFocus"
                                    QueryIcon="Find"
                                    QuerySubmitted="SegmentRouteAutoSuggestBox_QuerySubmitted"
                                    SuggestionChosen="SegmentRouteAutoSuggestBox_SuggestionChosen"
                                    TextChanged="SegmentRouteAutoSuggestBox_TextChanged" />

                                <ComboBox
                                    x:Name="SegmentPmComboBox"
                                    Header="Segment PM"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    PlaceholderText="Ketik manual atau pilih dari kolom H SEGMENTPM.xlsx"
                                    SelectionChanged="SegmentPmComboBox_SelectionChanged"
                                    Style="{StaticResource ShellInputComboBoxStyle}"
                                    TextSubmitted="SegmentPmComboBox_TextSubmitted" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="SystemKeyTextBox"
                                        Grid.Column="0"
                                        Header="System Key"
                                        PlaceholderText="Contoh: 25MAJAYNW123456"
                                        Style="{StaticResource ShellInputTextBoxStyle}"
                                        TextChanged="InputChanged" />

                                    <TextBox
                                        x:Name="CoordinateTextBox"
                                        Grid.Column="1"
                                        Header="Coordinate (DMS)"
                                        PlaceholderText="Contoh: 5°33'02.2N 95°21'52.8E"
                                        Style="{StaticResource ShellInputTextBoxStyle}"
                                        TextChanged="InputChanged" />
                                </Grid>

                                <Border
                                    x:Name="CoordinatePhotoDropZoneBorder"
                                    AllowDrop="True"
                                    Padding="12"
                                    Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    DragOver="CoordinatePhotoDropZoneBorder_DragOver"
                                    Drop="CoordinatePhotoDropZoneBorder_Drop">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="AI Coordinate From Photo" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                                            Text="Drop foto watermark koordinat (local/WhatsApp), atau paste dari clipboard." />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="LoadCoordinatePhotoButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                                <TextBlock Text="Load Photo" />
                                            </Button>
                                            <Button Click="PasteCoordinatePhotoButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                                <TextBlock Text="Paste WhatsApp Image" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="CoordinatePhotoStatusTextBlock"
                                            Foreground="{StaticResource ShellMutedForegroundBrush}"
                                            Text="Belum ada foto diproses." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Border Padding="12" Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource ShellSectionTitleStyle}"
                                    Text="Update Progress" />
                                <Button
                                    x:Name="TranslateUpdateProgressButton"
                                    Grid.Column="1"
                                    Click="TranslateUpdateProgressButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluentIcons:SymbolIcon Symbol="ArrowClockwise" />
                                        <TextBlock Text="Translate to English" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBox
                                x:Name="UpdateProgressTextBox"
                                AcceptsReturn="True"
                                MinHeight="200"
                                PlaceholderText="Masukkan update progress per baris..."
                                Style="{StaticResource ShellInputTextBoxStyle}"
                                TextChanged="InputChanged"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="UpdateProgressTranslateStatusTextBlock"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Style="{StaticResource ShellSectionCaptionStyle}"
                                Text="Terjemahan menggunakan Gemini AI (konsisten per tab)." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                x:Name="PreviewSectionBorder"
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource ShellGlassCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Document" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ShellSectionTitleStyle}" Text="Template Preview" />
                        <Border
                            Grid.Column="2"
                            Padding="8,4"
                            Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                            BorderBrush="{StaticResource ShellPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="999">
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Real-time" />
                        </Border>
                    </Grid>
                    <Border
                        x:Name="PreviewTextBoxHost"
                        Padding="12"
                        Background="{StaticResource ShellPanelSecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource ShellPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <TextBox
                            x:Name="TemplatePreviewTextBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            MinHeight="760"
                            Style="{StaticResource ShellInputTextBoxStyle}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

