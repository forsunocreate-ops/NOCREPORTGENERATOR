<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="16">
            <Border Style="{StaticResource ShellGlassCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="AI Settings" />
                    <TextBlock
                        Foreground="{StaticResource ShellMutedForegroundBrush}"
                        Text="Masukkan API Key Gemini untuk parsing watermark koordinat dari foto." />
                    <TextBox
                        x:Name="GeminiApiKeyTextBox"
                        Header="Gemini API Key (2.5-flash)"
                        PlaceholderText="AIza..."
                        Style="{StaticResource ShellInputTextBoxStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="SaveButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}">
                            <TextBlock Text="Save" />
                        </Button>
                        <Button Click="ClearButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                            <TextBlock Text="Clear" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Foreground="{StaticResource ShellMutedForegroundBrush}"
                        Text="-" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
