<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="16" />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SettingsRootGrid" Padding="20" RowSpacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="SettingsWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1080" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SettingsRootGrid.Padding" Value="20" />
                            <Setter Target="SettingsSecondColumn.Width" Value="*" />
                            <Setter Target="DataSyncCard.(Grid.Row)" Value="0" />
                            <Setter Target="DataSyncCard.(Grid.Column)" Value="1" />
                            <Setter Target="DataSyncCard.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SettingsCompactState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SettingsRootGrid.Padding" Value="12" />
                            <Setter Target="SettingsSecondColumn.Width" Value="0" />
                            <Setter Target="DataSyncCard.(Grid.Row)" Value="1" />
                            <Setter Target="DataSyncCard.(Grid.Column)" Value="0" />
                            <Setter Target="DataSyncCard.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ShellPageHeaderCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Configuration" />
                    <TextBlock
                        Style="{StaticResource ShellHeroTitleTextStyle}"
                        Text="AI Settings" />
                    <TextBlock
                        Foreground="{StaticResource ShellHeroSecondaryTextBrush}"
                        Text="Kelola API key Gemini untuk fitur parsing coordinate dan translasi progress." />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
                <Grid x:Name="SettingsCardsGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SettingsSecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="GeminiSettingsCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Gemini API" />
                            <TextBlock
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Simpan API key secara lokal untuk dipakai fitur AI di aplikasi ini." />
                            <PasswordBox
                                x:Name="GeminiApiKeyPasswordBox"
                                Header="Gemini API Key (2.5-flash)"
                                PlaceholderText="AIza..."
                                PasswordRevealMode="Peek"
                                Style="{StaticResource ShellInputPasswordBoxStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="SaveButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}">
                                    <TextBlock Text="Save" />
                                </Button>
                                <Button Click="ClearButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <TextBlock Text="Clear" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="StatusTextBlock"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="-" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="DataSyncCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ShellGlassSubtleCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Data Synchronize" />
                            <TextBlock
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Sinkronkan 3 sumber data: DATABASE_LINK.xlsb, SEGMENTPM.xlsx, dan DATABASE_TT.xlsx." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SynchronizeButton"
                                    Click="SynchronizeButton_Click"
                                    Style="{StaticResource ShellPrimaryButtonStyle}">
                                    <TextBlock Text="Synchronize Now" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="SyncStatusTextBlock"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Belum dijalankan." />

                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource ShellSectionTitleStyle}"
                                Text="File Import" />
                            <TextBlock
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Semua import file dipusatkan di Settings." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ImportTtTrackerButton"
                                    Click="ImportTtTrackerButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <TextBlock Text="Import TT Tracker" />
                                </Button>
                                <Button
                                    x:Name="ImportSegmentPmButton"
                                    Click="ImportSegmentPmButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <TextBlock Text="Import SegmentPM" />
                                </Button>
                                <Button
                                    x:Name="ImportSegmentRouteButton"
                                    Click="ImportSegmentRouteButton_Click"
                                    Style="{StaticResource ShellSecondaryButtonStyle}">
                                    <TextBlock Text="Import Segment Route" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="ImportStatusTextBlock"
                                Foreground="{StaticResource ShellMutedForegroundBrush}"
                                Text="Belum ada import file." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
