<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.IntegrationHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="12" />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ShellPageHeaderCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{StaticResource ShellHeroCaptionTextBrush}" Text="Advanced Workspace" />
                    <TextBlock Style="{StaticResource ShellHeroTitleTextStyle}" Text="Integration Health" />
                    <TextBlock Foreground="{StaticResource ShellHeroSecondaryTextBrush}" Text="Pantau konektivitas dan performa import pipeline (Excel, cache, API, storage)." />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ShellGlassCardStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SummaryTextBlock" Style="{StaticResource ShellSectionTitleStyle}" Text="Loading data..." />
                        <TextBlock x:Name="LastUpdatedTextBlock" Style="{StaticResource ShellSectionCaptionStyle}" Text="Updated -" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}" Content="Refresh" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ShellGlassSubtleCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="Kpi1LabelTextBlock" Style="{StaticResource ShellSectionCaptionStyle}" Text="KPI 1" />
                        <TextBlock x:Name="Kpi1ValueTextBlock" Style="{StaticResource ShellSectionTitleStyle}" Text="0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ShellGlassSubtleCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="Kpi2LabelTextBlock" Style="{StaticResource ShellSectionCaptionStyle}" Text="KPI 2" />
                        <TextBlock x:Name="Kpi2ValueTextBlock" Style="{StaticResource ShellSectionTitleStyle}" Text="0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ShellGlassSubtleCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="Kpi3LabelTextBlock" Style="{StaticResource ShellSectionCaptionStyle}" Text="KPI 3" />
                        <TextBlock x:Name="Kpi3ValueTextBlock" Style="{StaticResource ShellSectionTitleStyle}" Text="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ShellGlassCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="7-Day Trend" />
                        <lvc:CartesianChart x:Name="TrendChart" Height="210" LegendPosition="Hidden" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ShellGlassCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Connector Status" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Operational visibility panel" />
                            <ListView x:Name="LeftListView" Height="290" SelectionChanged="ListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Padding="0,2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ShellGlassCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ShellSectionTitleStyle}" Text="Recent Errors" />
                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="Execution and recommendation panel" />
                            <ListView x:Name="RightListView" Height="290" SelectionChanged="ListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Padding="0,2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource ShellSectionCaptionStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource ShellGlassCardStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CommandTextBox"
                        Grid.Column="0"
                        PlaceholderText="Filter data, ketik INC number, command module, atau ketik export/pdf di Report Builder..."
                        Style="{StaticResource ShellInputTextBoxStyle}"
                        TextChanged="CommandTextBox_TextChanged" />
                    <Button Grid.Column="1" Click="RefreshButton_Click" Style="{StaticResource ShellSecondaryButtonStyle}" Content="Refresh" />
                    <Button Grid.Column="2" Click="OpenActionButton_Click" Style="{StaticResource ShellPrimaryButtonStyle}" Content="Open Action" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
