<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NOCREPORTGENERATOR.Pages.LiveMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
            <EntranceThemeTransition FromVerticalOffset="22" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid x:Name="LiveMapRootGrid" Padding="16" RowSpacing="12">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True" />
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="LiveMapWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LiveMapRootGrid.Padding" Value="16" />
                        <Setter Target="MapToolbarFirstColumn.Width" Value="*" />
                        <Setter Target="MapToolbarSecondColumn.Width" Value="Auto" />
                        <Setter Target="MapSearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="MapActionPanel.(Grid.Column)" Value="1" />
                        <Setter Target="MapSearchBox.(Grid.Row)" Value="0" />
                        <Setter Target="MapActionPanel.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LiveMapCompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LiveMapRootGrid.Padding" Value="10" />
                        <Setter Target="MapToolbarFirstColumn.Width" Value="*" />
                        <Setter Target="MapToolbarSecondColumn.Width" Value="0" />
                        <Setter Target="MapSearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="MapActionPanel.(Grid.Column)" Value="0" />
                        <Setter Target="MapSearchBox.(Grid.Row)" Value="0" />
                        <Setter Target="MapActionPanel.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ShellGlassCardStyle}">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MapToolbarFirstColumn" Width="*" />
                    <ColumnDefinition x:Name="MapToolbarSecondColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="MapSearchBox"
                    PlaceholderText="Cari lokasi / koordinat..."
                    QueryIcon="Find"
                    QuerySubmitted="MapSearchBox_QuerySubmitted"
                    Style="{StaticResource ShellInputAutoSuggestBoxStyle}" />

                <StackPanel
                    x:Name="MapActionPanel"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="MapCenterButton"
                        Click="MapCenterButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xEF0A;" />
                            <TextBlock Text="Center to Indonesia" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="From" />
                    <CalendarDatePicker
                        x:Name="FromDatePicker"
                        Grid.Column="1"
                        PlaceholderText="Pilih tanggal"
                        VerticalAlignment="Center"
                        DateChanged="FromDatePicker_DateChanged" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="To" />
                    <CalendarDatePicker
                        x:Name="ToDatePicker"
                        Grid.Column="3"
                        PlaceholderText="Pilih tanggal"
                        VerticalAlignment="Center"
                        DateChanged="ToDatePicker_DateChanged" />

                    <ComboBox
                        x:Name="StatusFilterComboBox"
                        Grid.Column="4"
                        PlaceholderText="Status"
                        VerticalAlignment="Center"
                        SelectionChanged="StatusFilterComboBox_SelectionChanged" />

                    <ComboBox
                        x:Name="SeverityFilterComboBox"
                        Grid.Column="5"
                        PlaceholderText="Severity"
                        VerticalAlignment="Center"
                        SelectionChanged="SeverityFilterComboBox_SelectionChanged" />

                    <StackPanel
                        Grid.Column="6"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="Heatmap" />
                        <ToggleSwitch
                            x:Name="HeatmapToggleSwitch"
                            Toggled="HeatmapToggleSwitch_Toggled" />
                    </StackPanel>

                    <Button
                        x:Name="ExportCsvButton"
                        Grid.Column="7"
                        Click="ExportCsvButton_Click"
                        VerticalAlignment="Center"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource RemixIconFontFamily}" Glyph="&#xECD9;" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SmartFilterAutoSuggestBox"
                        Grid.Column="0"
                        PlaceholderText="Smart filter: tt:INC-..., seg:jakarta, cp:otdr, from:2026-02-01 to:2026-02-13"
                        QuerySubmitted="SmartFilterAutoSuggestBox_QuerySubmitted"
                        SuggestionChosen="SmartFilterAutoSuggestBox_SuggestionChosen"
                        TextChanged="SmartFilterAutoSuggestBox_TextChanged" />

                    <ComboBox
                        x:Name="SegmentRouteFilterComboBox"
                        Grid.Column="1"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        PlaceholderText="Segment Route"
                        SelectionChanged="SegmentRouteFilterComboBox_SelectionChanged" />

                    <ComboBox
                        x:Name="QuickFilterComboBox"
                        Grid.Column="2"
                        SelectionChanged="QuickFilterComboBox_SelectionChanged" />

                    <Button
                        x:Name="ApplyFilterButton"
                        Grid.Column="3"
                        Click="ApplyFilterButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <TextBlock Text="Apply Filter" />
                    </Button>

                    <Button
                        x:Name="ClearFilterButton"
                        Grid.Column="4"
                        Click="ClearFilterButton_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}">
                        <TextBlock Text="Clear" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="MapFilterSummaryTextBlock"
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource ShellSectionCaptionStyle}"
                    Text="0 marker tampil" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="8"
            Style="{StaticResource ShellGlassCardStyle}">
            <Border
                Padding="6"
                Style="{StaticResource ShellGlassSubtleCardStyle}">
                <WebView2 x:Name="MapWebView" />
            </Border>
        </Border>
    </Grid>
</Page>
